{
  "request": {
    "method": "POST",
    "urlPattern": "/v1/chat/completions"
  },
  "response": {
    "status": 429,
    "headers": {
      "Content-Type": "application/json",
      "Retry-After": "60"
    },
    "jsonBody": {
      "error": {
        "message": "Rate limit exceeded",
        "type": "requests",
        "code": "rate_limit_exceeded"
      }
    }
  }
}
