    <artifactId>app</artifactId>
    <description>Spring Boot application entry point and configuration</description>

    <dependencies>
        <dependency>
            <groupId>com.fieldservice</groupId>
            <artifactId>platform</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fieldservice</groupId>
            <artifactId>domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fieldservice</groupId>
            <artifactId>aigateway</artifactId>
        </dependency>
        <dependency>
