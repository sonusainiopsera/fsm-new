{
  "name": "field-service-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "generate-tokens": "node scripts/generate-token-contract.mjs",
    "generate-api-client": "node scripts/generate-api-client.mjs",
    "check-api-client": "node scripts/generate-api-client.mjs --check",
    "prebuild": "npm run generate-tokens",
    "build": "vite build",
    "build:node": "npm run generate-tokens && npm run generate-api-client && npm run lint && npm run stylelint && npm run typecheck && npm run test:coverage && npm run check-api-client && npm run test:a11y && npm run test:performance && npm run audit:design-system && vite build",
    "lint": "eslint src --ext .js,.jsx --max-warnings 0 --rulesdir eslint-local-rules",
    "stylelint": "stylelint \"src/**/*.css\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:a11y": "playwright test --project=a11y",
    "test:performance": "playwright test --project=performance",
    "audit:design-system": "node scripts/audit-design-system.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "test:technician": "playwright test --project=technician",
    "test:e2e:technician": "playwright test --project=technician-mobile"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.56.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "@playwright/test": "^1.47.2",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.3",
    "axe-core": "^4.10.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.35.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^24.1.3",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1",
    "vite": "^5.4.3",
    "vitest": "^2.1.3"
  }
}
