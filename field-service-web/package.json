{
  "name": "field-service-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx --max-warnings 0",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "stylelint": "stylelint \"src/**/*.css\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:a11y": "playwright test tests/a11y",
    "test:performance": "playwright test tests/performance",
    "audit:design-system": "node scripts/audit-design-system.mjs",
    "prebuild": "node scripts/generate-token-contract.mjs",
    "build:catalogue": "VITE_CATALOGUE=true vite build --outDir dist-catalogue",
    "build:ci": "npm run stylelint && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run build:catalogue && npm run audit:design-system",
    "build:node": "npm run stylelint && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run build:catalogue && npm run audit:design-system"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "@playwright/test": "^1.45.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^15.0.7",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.0",
    "axe-core": "^4.9.1",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-local-rules": "^2.0.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^24.1.0",
    "stylelint": "^16.6.1",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}
