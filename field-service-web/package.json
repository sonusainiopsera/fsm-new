{
  "name": "field-service-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:node": "npm run stylelint && npm run lint && npm run typecheck && npm run test:coverage && vite build",
    "preview": "vite preview",
    "prebuild": "node scripts/generate-token-contract.mjs",
    "lint": "eslint src --ext .js,.jsx --rulesdir eslint-local-rules",
    "stylelint": "stylelint \"src/**/*.css\" --ignore-path .stylelintignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate-tokens": "node scripts/generate-token-contract.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^24.1.1",
    "stylelint": "^16.8.2",
    "stylelint-config-standard": "^36.0.1",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
