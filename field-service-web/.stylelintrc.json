{
  "extends": ["stylelint-config-standard"],
  "ignoreFiles": [
    "src/styles/tokens.contract.css",
    "src/styles/tokens.light.css",
    "src/styles/tokens.dark.css",
    "src/styles/base.css",
    "node_modules/**"
  ],
  "rules": {
    "declaration-block-no-duplicate-properties": true,
    "declaration-property-value-disallowed-list": {
      "outline": ["none", "0"],
      "outline-style": ["none"]
    },
    "declaration-property-value-allowed-list": {
      "color": ["/^var\\(--/", "inherit", "transparent", "currentColor"],
      "background-color": ["/^var\\(--/", "transparent", "none", "inherit"],
      "background": ["/^var\\(--/", "transparent", "none", "inherit"],
      "border-color": ["/^var\\(--/", "transparent", "inherit"],
      "border-top-color": ["/^var\\(--/", "transparent", "inherit"],
      "border-right-color": ["/^var\\(--/", "transparent", "inherit"],
      "border-bottom-color": ["/^var\\(--/", "transparent", "inherit"],
      "border-left-color": ["/^var\\(--/", "transparent", "inherit"],
      "outline-color": ["/^var\\(--/", "transparent"],
      "caret-color": ["/^var\\(--/"],
      "fill": ["/^var\\(--/", "transparent", "none", "currentColor"],
      "stroke": ["/^var\\(--/", "transparent", "none", "currentColor"],
      "border-radius": ["/^var\\(--/", "0", "50%", "100%", "inherit"],
      "border-top-left-radius": ["/^var\\(--/", "0", "50%", "100%"],
      "border-top-right-radius": ["/^var\\(--/", "0", "50%", "100%"],
      "border-bottom-left-radius": ["/^var\\(--/", "0", "50%", "100%"],
      "border-bottom-right-radius": ["/^var\\(--/", "0", "50%", "100%"],
      "padding": ["/^var\\(--/", "0", "auto", "inherit"],
      "padding-top": ["/^var\\(--/", "0"],
      "padding-right": ["/^var\\(--/", "0"],
      "padding-bottom": ["/^var\\(--/", "0"],
      "padding-left": ["/^var\\(--/", "0"],
      "margin": ["/^var\\(--/", "0", "auto", "inherit"],
      "margin-top": ["/^var\\(--/", "0", "auto"],
      "margin-right": ["/^var\\(--/", "0", "auto"],
      "margin-bottom": ["/^var\\(--/", "0", "auto"],
      "margin-left": ["/^var\\(--/", "0", "auto"],
      "gap": ["/^var\\(--/", "0"],
      "row-gap": ["/^var\\(--/", "0"],
      "column-gap": ["/^var\\(--/", "0"],
      "box-shadow": ["/^var\\(--/", "none"],
      "transition-duration": ["/^var\\(--/", "0s", "0ms"],
      "animation-duration": ["/^var\\(--/", "0s", "0ms"]
    }
  }
}
